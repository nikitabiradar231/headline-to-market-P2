# Headline to Market - Environment Configuration

# Port for Express API server (defaults to 3001)
PORT=3001

# Anthropic Claude API Key (optional for development; if omitted, deterministic mock provider is used)
ANTHROPIC_API_KEY=

# Model selection (defaults to claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Force deterministic mock mode for offline testing and development (true/false)
MOCK_LLM=false

# SQLite Database file path
DATABASE_PATH=./data/markets.db

# Request timeout in milliseconds (default: 15000 ms)
LLM_TIMEOUT_MS=15000

# Max retries for transient failures (default: 2)
LLM_MAX_RETRIES=2
